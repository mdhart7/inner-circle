<!DOCTYPE html>
<html>
  <head>
    <title>Inner Circle</title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#000000">
    <link rel="manifest" href="<%= pwa_manifest_path %>">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black">
    <meta name="apple-mobile-web-app-title" content="Inner Circl">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>

    <meta name="csrf-token" content="<%= form_authenticity_token %>">
    
    <%= javascript_importmap_tags %>
  </head>

  <body style="background-color: #000; color: #fff;">
    <main>
      <% if notice %>
        <p style="color: #00ff00; text-align: center; padding: 10px 0;"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p style="color: #ff3333; text-align: center; padding: 10px 0;"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
