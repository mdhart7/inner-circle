<style>
  .nav-bar {
    display: flex; justify-content: flex-start; align-items: center;
    padding: 20px; border-bottom: 1px solid #333; background-color: #000;
    position: sticky; top: 0; z-index: 100;
  }
  .nav-btn {
    background: none;
    border: none;
    color: #999;
    cursor: pointer;
    font-size: 14px;
    text-decoration: none;
  }
  .nav-btn:hover {
    color: #fff;
  }

  .inner-container { max-width: 600px; margin: 0 auto; padding: 20px; }
  .page-title { font-size: 26px; font-weight: 700; margin-bottom: 4px; }
  .page-subtitle { color: #999; margin-bottom: 25px; }

  .style-box {
    background: #111; border: 1px solid #333; padding: 20px;
    border-radius: 20px; margin-bottom: 20px;
  }
  .style-box h3 { margin-top: 0; }

  .qfield { margin-bottom: 20px; }
  .qfield legend { font-weight: 600; margin-bottom: 8px; }
  .qhelp { color: #888; font-size: 13px; margin: 0 0 10px; }
  .qoptions { display: flex; flex-wrap: wrap; gap: 8px; }
  .qoption {
    background: #1a1a1a; border: 1px solid #333; color: #fff;
    padding: 10px 16px; border-radius: 12px; cursor: pointer; font-size: 14px;
  }
  .qoption input { position: absolute; opacity: 0; pointer-events: none; }
  .qoption:has(input:checked) { border-color: #00bfff; background: #003a4d; }

  select.style-select {
    width: 100%; padding: 12px; border-radius: 12px; border: 1px solid #444;
    background: #1a1a1a; color: #fff; font-size: 16px;
  }

  .style-submit-btn {
    width: 100%; padding: 14px; border-radius: 12px; background: #00bfff;
    border: none; font-weight: 700; font-size: 16px; margin-top: 10px; cursor: pointer;
  }

  .swatch-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin-top: 14px; }
  .swatch { border-radius: 14px; overflow: hidden; border: 1px solid #333; background: #1a1a1a; }
  .swatch .fill { height: 70px; }
  .swatch .body { padding: 8px 10px 10px; font-size: 13px; }
  .swatch .body b { display: block; font-size: 14px; }
  .swatch .hex { color: #888; font-size: 11px; }
  .swatch .why { color: #aaa; margin-top: 4px; }
  .combination-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin-top: 14px; }
  .combination-card { overflow: hidden; border: 1px solid #333; border-radius: 14px; background: #1a1a1a; }
  .combination-colors { display: grid; grid-template-columns: 1fr 1fr; height: 76px; }
  .combination-colors div { min-width: 0; }
  .combination-body { padding: 10px; font-size: 13px; }
  .combination-names { font-weight: 700; }
  .combination-why { color: #aaa; margin-top: 5px; }
  .combination-tag { display: inline-block; color: #00bfff; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 4px; }
  .metal-preference { margin: 14px 0 24px; }
  .metal-bar { display: flex; width: 100%; height: 36px; overflow: hidden; border: 1px solid #444; border-radius: 10px; }
  .metal-bar-gold, .metal-bar-silver { display: flex; align-items: center; justify-content: center; color: #111; font-size: 12px; font-weight: 700; white-space: nowrap; }
  .metal-bar-gold { background: #C8A24A; }
  .metal-bar-silver { background: #C0C3C7; }
  .metal-caption { color: #aaa; font-size: 13px; margin-top: 7px; }
  .retake-link { color: #00bfff; font-size: 14px; text-decoration: none; }

  .rule-list { display: grid; gap: 10px; margin-top: 14px; }
  .rule { background: #111; border: 1px solid #333; border-radius: 14px; padding: 12px 14px; }
  .rule b { display: block; }
  .rule p { color: #aaa; font-size: 14px; margin: 4px 0 0; }
  .fill-strip { display: flex; }
  .fill-strip span { flex: 1; }

  .generator-box {
    background: #111; border: 1px solid #333; border-radius: 20px;
    padding: 16px; margin-top: 24px;
  }
  .generator-box label { font-weight: 600; display: block; margin-bottom: 8px; }
  .generator-select {
    width: 100%; padding: 12px; border-radius: 12px; border: 1px solid #444;
    background: #1a1a1a; color: #fff; font-size: 16px; box-sizing: border-box;
  }
  .generator-hint { color: #888; font-size: 12px; margin-top: 6px; }
  .generator-reroll-btn {
    width: 100%; padding: 12px; border-radius: 12px; background: #1a1a1a;
    border: 1px solid #00bfff; color: #00bfff; font-weight: 700; font-size: 14px;
    margin-top: 12px; cursor: pointer; display: none;
  }
  .generator-reroll-btn.show { display: block; }
  .generator-results { margin-top: 16px; display: none; }
  .generator-results.show { display: block; }
  .pattern-preference { margin-top: 16px; display: none; }
  .pattern-preference.show { display: block; }
  .pattern-bar {
    width: 100%; height: 56px; border: 1px solid #444; border-radius: 10px;
    background-color: #1a1a1a; box-sizing: border-box;
  }
  .pattern-caption { color: #aaa; font-size: 13px; margin-top: 7px; }
</style>

<div class="nav-bar">
  <%= link_to root_path, class: "nav-btn back-to-feed-link" do %>
    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
    Back to Feed
  <% end %>
</div>

<div class="inner-container">
  <h1 class="page-title">Your Style</h1>

  <% if @style_profile&.persisted? %>
    <p class="page-subtitle">
      Based on your questionnaire answers.
      <%= link_to "Retake", "#", class: "retake-link", onclick: "document.getElementById('questionnaire').hidden = false; document.getElementById('results').hidden = true; return false;" %>
    </p>

    <% palette = @style_profile.palette %>
    <div id="results">
      <div class="style-box">
        <p><%= palette.summary %></p>
        <% if palette.eye_line %>
          <p><%= palette.eye_line %></p>
        <% end %>
      </div>

      <h3>Lean toward</h3>
      <% if palette.lean_toward_intro %>
        <p class="page-subtitle"><%= palette.lean_toward_intro %></p>
      <% end %>
      <div class="swatch-grid">
        <% palette.lean_toward.each_with_index do |s, i| %>
          <div class="swatch">
            <div class="fill" style="background: <%= s.hex %>;"></div>
            <div class="body">
              <b><%= i + 1 %>. <%= s.name %></b>
              <span class="hex"><%= s.hex %></span>
              <p class="why"><%= s.why %></p>
            </div>
          </div>
        <% end %>
      </div>

      <h3>Supporting neutrals</h3>
      <p class="page-subtitle"><%= palette.neutral_note %></p>
      <div class="swatch-grid">
        <% palette.neutrals.each do |s| %>
          <div class="swatch">
            <div class="fill" style="background: <%= s.hex %>;"></div>
            <div class="body">
              <b><%= s.name %></b>
              <span class="hex"><%= s.hex %></span>
              <p class="why"><%= s.why %></p>
            </div>
          </div>
        <% end %>
      </div>

      <h3>Accent colors</h3>
      <div class="swatch-grid">
        <% palette.accent_colors.each do |s| %>
          <div class="swatch">
            <div class="fill" style="background: <%= s.hex %>;"></div>
            <div class="body"><b><%= s.name %></b><span class="hex"><%= s.hex %></span></div>
          </div>
        <% end %>
      </div>

      <% gold_percentage = palette.gold_metal_percentage %>
      <% silver_percentage = 100 - gold_percentage %>
      <h3>Jewelry metals</h3>
      <div class="metal-preference">
        <div class="metal-bar" role="img" aria-label="<%= palette.metal_preference %>">
          <% if gold_percentage.positive? %>
            <div class="metal-bar-gold" style="width: <%= gold_percentage %>%;"></div>
          <% end %>
          <% if silver_percentage.positive? %>
            <div class="metal-bar-silver" style="width: <%= silver_percentage %>%;"></div>
          <% end %>
        </div>
        <p class="metal-caption"><%= palette.metal_preference %> based on your undertone.</p>
      </div>

      <h3>Lean away</h3>
      <% if palette.lean_away_intro %>
        <p class="page-subtitle"><%= palette.lean_away_intro %></p>
      <% end %>
      <div class="swatch-grid">
        <% palette.lean_away.each do |s| %>
          <div class="swatch">
            <% colors = s.hexes.presence || (s.hex ? [ s.hex ] : []) %>
            <% if colors.any? %>
              <div class="fill fill-strip">
                <% colors.each do |hex| %>
                  <span style="background: <%= hex %>;"></span>
                <% end %>
              </div>
            <% end %>
            <div class="body">
              <b><%= s.name %></b>
              <% if s.hex && s.hexes.blank? %>
                <span class="hex"><%= s.hex %></span>
              <% end %>
              <p class="why"><%= s.why %></p>
            </div>
          </div>
        <% end %>
      </div>

      <h3>Outfit generator</h3>
      <div class="generator-box">
        <label for="generator-select">Pick one of your 8 main colors</label>
        <select id="generator-select" class="generator-select" onchange="generateOutfits(true)">
          <option value="">Choose a color...</option>
          <% palette.lean_toward.each do |c| %>
            <option value="<%= c.name %>"><%= c.name %></option>
          <% end %>
        </select>
        <p class="generator-hint">
          Generates 4 random pairings: a close shade, a contrasting shade, one of your accent colors,
          and another color from your palette. Not limited to your palette's exact hexes for the
          close/contrasting shades &mdash; those pull from anywhere on the color wheel.
        </p>
        <button type="button" class="generator-reroll-btn" id="generator-reroll-btn" onclick="generateOutfits(false)">
          Generate another set
        </button>
        <div class="generator-results" id="generator-results"></div>
        <div class="pattern-preference" id="pattern-preference" aria-live="polite">
          <div class="pattern-bar" id="pattern-bar"></div>
          <p class="pattern-caption" id="pattern-caption"></p>
        </div>
      </div>

      <h3>Color theory, applied to you</h3>
      <div class="rule-list">
        <% palette.color_theory_rules.each_with_index do |(title, body), index| %>
          <div class="rule">
            <b><%= index + 1 %>. <%= title %></b>
            <p><%= body %></p>
          </div>
        <% end %>
      </div>
    </div>

    <div id="questionnaire" hidden>
      <%= render "form", style_profile: @style_profile %>
    </div>

    <script type="application/json" id="generator-data"><%== raw(
      {
        lean_toward: palette.lean_toward.map { |c| { name: c.name, hex: c.hex } },
        accent_colors: palette.accent_colors.map { |c| { name: c.name, hex: c.hex } }
      }.to_json
    ) %></script>

    <script>
      // -- hex <-> HSL, so "close" and "contrasting" shades can come from
      // anywhere on the color wheel, not just this person's own swatches.
      function hexToHsl(hex) {
        const r = parseInt(hex.slice(1, 3), 16) / 255;
        const g = parseInt(hex.slice(3, 5), 16) / 255;
        const b = parseInt(hex.slice(5, 7), 16) / 255;
        const max = Math.max(r, g, b), min = Math.min(r, g, b);
        let h, s;
        const l = (max + min) / 2;
        if (max === min) {
          h = s = 0;
        } else {
          const d = max - min;
          s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
          switch (max) {
            case r: h = (g - b) / d + (g < b ? 6 : 0); break;
            case g: h = (b - r) / d + 2; break;
            default: h = (r - g) / d + 4;
          }
          h /= 6;
        }
        return [h * 360, s * 100, l * 100];
      }

      function hslToHex(h, s, l) {
        h = ((h % 360) + 360) % 360;
        s = Math.min(100, Math.max(0, s)) / 100;
        l = Math.min(100, Math.max(0, l)) / 100;
        const c = (1 - Math.abs(2 * l - 1)) * s;
        const x = c * (1 - Math.abs(((h / 60) % 2) - 1));
        const m = l - c / 2;
        let r, g, b;
        if (h < 60) [r, g, b] = [c, x, 0];
        else if (h < 120) [r, g, b] = [x, c, 0];
        else if (h < 180) [r, g, b] = [0, c, x];
        else if (h < 240) [r, g, b] = [0, x, c];
        else if (h < 300) [r, g, b] = [x, 0, c];
        else [r, g, b] = [c, 0, x];
        const toHex = (v) => Math.round((v + m) * 255).toString(16).padStart(2, "0");
        return `#${toHex(r)}${toHex(g)}${toHex(b)}`;
      }

      // Rough, procedural naming for colors generated on the fly (not from
      // this person's curated swatches), so results still show a label
      // instead of just a hex code.
      function approxColorName(h, s, l) {
        const hues = [
          [15, "Red"], [45, "Orange"], [70, "Amber"], [90, "Yellow"], [150, "Green"],
          [180, "Teal"], [210, "Cyan"], [240, "Blue"], [270, "Indigo"], [300, "Purple"],
          [330, "Magenta"], [360, "Red"]
        ];
        let base = "Red";
        for (const [max, label] of hues) {
          if (h <= max) { base = label; break; }
        }
        const lightnessWord = l < 25 ? "Deep " : l > 78 ? "Pale " : l > 60 ? "Light " : "";
        const satWord = s < 28 ? "Muted " : "";
        return `${lightnessWord}${satWord}${base}`.trim();
      }

      function randomBetween(min, max) {
        return min + Math.random() * (max - min);
      }

      // ---- Pattern matching ----------------------------------------------
      // Which patterns look good WITH a color, written by hand per color group.
      // (Not "a pattern in that color": red does not get red plaid just for being red.)
      const PATTERN_RULES = {
        "Reds and wines": ["Dark wash denim", "Navy pinstripe", "Camel corduroy", "Green camo", "Red plaid", "Brown tweed"],
        "Oranges and terracottas": ["Camel corduroy", "Dark wash denim", "Black denim", "Navy pinstripe", "Light wash denim"],
        "Browns and camels": ["Red plaid", "Navy pinstripe", "Dark wash denim", "Camel corduroy", "Brown tweed", "Flannel plaid"],
        "Golds and yellows": ["Red plaid", "Dark wash denim", "Navy pinstripe", "Flannel plaid"],
        "Olives and greens": ["Green camo", "Light wash denim", "Dark wash denim", "Black denim", "Red plaid"],
        "Teals": ["Camel corduroy", "Light wash denim", "Dark wash denim"],
        "Lighter blues": ["Dark wash denim", "Navy pinstripe"],
        "Darker blues and navies": ["Light wash denim", "Blue gingham", "Breton stripe", "Brown tweed"],
        "Purples and plums": ["Camel corduroy", "Brown tweed", "Dark wash denim", "Light wash denim"],
        "Pinks and roses": ["Camel corduroy", "Green camo", "Charcoal herringbone", "Dark wash denim"],
        "Black, charcoal and gray": ["Light wash denim", "Red plaid", "Green camo", "Black denim"],
        "Cream, white and stone": ["Light wash denim", "Dark wash denim", "Green camo", "Red plaid", "Navy pinstripe", "Brown tweed", "Charcoal herringbone"]
      };
      // Fits marked "for certain" come up twice as often as the rest of their group.
      const STRONG_FITS = { "Cream, white and stone": ["Navy pinstripe"], "Darker blues and navies": ["Brown tweed"] };

      // Sort any color into one of the groups above.
      function colorGroup(h, s, l) {
        const hue = ((h % 360) + 360) % 360;
        if (l <= 12) return "Black, charcoal and gray";
        if (l >= 85) return "Cream, white and stone";
        if (s < 10) return l >= 80 ? "Cream, white and stone" : "Black, charcoal and gray";
        // soft, warm, light-to-mid neutrals: sand, taupe, greige, mushroom
        if (hue >= 15 && hue < 65 && ((s < 35 && l >= 50) || (s < 45 && l >= 65))) return "Cream, white and stone";
        if (hue >= 335 || hue < 10) return l >= 55 ? "Pinks and roses" : "Reds and wines";
        if (hue < 30) return l >= 38 ? "Oranges and terracottas" : "Browns and camels";
        if (hue < 70 && s >= 55) return "Golds and yellows";
        if (hue < 50) return "Browns and camels";
        if (hue < 165) return "Olives and greens";
        if (hue < 195) return "Teals";
        if (hue < 255) return l >= 50 ? "Lighter blues" : "Darker blues and navies";
        if (hue < 300) return "Purples and plums";
        return (s >= 60 && l >= 38) || l >= 62 ? "Pinks and roses" : "Purples and plums";
      }

      // One of the patterns that fits this color, picked at random each time.
      function pickPattern(h, s, l) {
        const group = colorGroup(h, s, l);
        const strong = STRONG_FITS[group] || [];
        const pool = PATTERN_RULES[group].flatMap((name) => (strong.includes(name) ? [name, name] : [name]));
        return pool[Math.floor(Math.random() * pool.length)];
      }

      // ---- Pattern swatches, drawn in code (no image files) ----------------
      function mulberry32(seed) {
        return function () {
          seed |= 0; seed = (seed + 0x6D2B79F5) | 0;
          let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
          t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
          return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
        };
      }

      function svgTile(w, h, body) {
        return `<svg xmlns="http://www.w3.org/2000/svg" width="${w}" height="${h}" viewBox="0 0 ${w} ${h}">${body}</svg>`;
      }

      function denimTile(base, dark, light, darkOpacity, lightOpacity) {
        return svgTile(6, 6, `<rect width="6" height="6" fill="${base}"/>` +
          `<path d="M0 6 L6 0 M-1 1 L1 -1 M5 7 L7 5" stroke="${dark}" stroke-opacity="${darkOpacity}" stroke-width="1.1"/>` +
          `<path d="M0 3 L3 0 M3 6 L6 3" stroke="${light}" stroke-opacity="${lightOpacity}" stroke-width="0.9"/>`);
      }

      // Scatter small shapes across a tile, repeating any that touch an edge so the tile joins up.
      function scatterTile(w, h, base, shapes) {
        const out = [`<rect width="${w}" height="${h}" fill="${base}"/>`];
        shapes.forEach(({ x, y, rx, ry, rot, color, opacity, margin }) => {
          [-w, 0, w].forEach((dx) => [-h, 0, h].forEach((dy) => {
            if (x + dx > -margin && x + dx < w + margin && y + dy > -margin && y + dy < h + margin) {
              out.push(`<ellipse cx="${(x + dx).toFixed(1)}" cy="${(y + dy).toFixed(1)}" rx="${rx.toFixed(1)}" ry="${ry.toFixed(1)}" ` +
                `transform="rotate(${Math.round(rot)} ${(x + dx).toFixed(1)} ${(y + dy).toFixed(1)})" fill="${color}"${opacity ? ` fill-opacity="${opacity}"` : ""}/>`);
            }
          }));
        });
        return svgTile(w, h, out.join(""));
      }

      const PATTERN_TILES = {
        "Light wash denim": () => denimTile("#93B1CE", "#4C6F9A", "#FFFFFF", 0.30, 0.24),
        "Dark wash denim": () => denimTile("#1E2B45", "#0B1424", "#5F7FB0", 0.55, 0.24),
        "Black denim": () => denimTile("#1A1B1E", "#000000", "#6B6F78", 0.55, 0.20),
        "Red plaid": () => svgTile(48, 48, '<rect width="48" height="48" fill="#9B1C26"/>' +
          '<rect x="0" width="12" height="48" fill="#12070A" fill-opacity=".58"/><rect y="0" width="48" height="12" fill="#12070A" fill-opacity=".58"/>' +
          '<rect x="22" width="1.6" height="48" fill="#F1D88E" fill-opacity=".8"/><rect y="22" width="48" height="1.6" fill="#F1D88E" fill-opacity=".8"/>' +
          '<rect x="35" width="1.2" height="48" fill="#0F1A33" fill-opacity=".7"/><rect y="35" width="48" height="1.2" fill="#0F1A33" fill-opacity=".7"/>'),
        "Flannel plaid": () => {
          const r = mulberry32(3); let specks = "";
          for (let i = 0; i < 90; i++) specks += `<circle cx="${(r() * 56).toFixed(1)}" cy="${(r() * 56).toFixed(1)}" r=".6" fill="#fff" fill-opacity=".14"/>`;
          return svgTile(56, 56, '<rect width="56" height="56" fill="#6C5A3C"/>' +
            '<rect x="0" width="14" height="56" fill="#241810" fill-opacity=".4"/><rect y="0" width="56" height="14" fill="#241810" fill-opacity=".4"/>' +
            '<rect x="28" width="2" height="56" fill="#E9DDBE" fill-opacity=".65"/><rect y="28" width="56" height="2" fill="#E9DDBE" fill-opacity=".65"/>' +
            '<rect x="43" width="2" height="56" fill="#A4572F" fill-opacity=".7"/><rect y="43" width="56" height="2" fill="#A4572F" fill-opacity=".7"/>' + specks);
        },
        "Blue gingham": () => svgTile(24, 24, '<rect width="24" height="24" fill="#F4F6F9"/>' +
          '<rect x="0" width="12" height="24" fill="#3B66B0" fill-opacity=".5"/><rect y="0" width="24" height="12" fill="#3B66B0" fill-opacity=".5"/>'),
        "Brown tweed": () => {
          const r = mulberry32(11); const colors = ["#C8B18A", "#3B2C1F", "#A2855C", "#E3D3B1", "#5A4430", "#8B6B47"]; const shapes = [];
          for (let i = 0; i < 220; i++) {
            shapes.push({ x: r() * 64, y: r() * 64, rx: 0.8 + r() * 1.2, ry: 0.6 + r() * 0.7, rot: r() * 180, color: colors[Math.floor(r() * colors.length)], opacity: ".85", margin: 4 });
          }
          return scatterTile(64, 64, "#7A5F43", shapes);
        },
        "Charcoal herringbone": () => {
          let left = "", right = "";
          for (let y = -9; y < 13; y += 3) { left += `<path d="M0 ${y + 8} L8 ${y}"/>`; right += `<path d="M8 ${y} L16 ${y + 8}"/>`; }
          return svgTile(16, 12, '<rect width="16" height="12" fill="#3A3D42"/>' +
            '<clipPath id="a"><rect width="8" height="12"/></clipPath><clipPath id="b"><rect x="8" width="8" height="12"/></clipPath>' +
            `<g clip-path="url(#a)" stroke="#9AA0A8" stroke-opacity=".55" stroke-width="1">${left}</g><g clip-path="url(#b)" stroke="#9AA0A8" stroke-opacity=".55" stroke-width="1">${right}</g>` +
            `<g clip-path="url(#a)" stroke="#16181B" stroke-opacity=".6" stroke-width=".8" transform="translate(0 1.5)">${left}</g><g clip-path="url(#b)" stroke="#16181B" stroke-opacity=".6" stroke-width=".8" transform="translate(0 1.5)">${right}</g>`);
        },
        "Camel corduroy": () => svgTile(8, 8, '<rect width="8" height="8" fill="#B38B5B"/>' +
          '<rect x="0" width="3.5" height="8" fill="#6F5130" fill-opacity=".38"/><rect x="3.5" width="1.6" height="8" fill="#fff" fill-opacity=".13"/>'),
        "Navy pinstripe": () => svgTile(14, 14, '<rect width="14" height="14" fill="#1B2540"/><rect x="6.5" width="1" height="14" fill="#E9EDF5" fill-opacity=".78"/>'),
        "Breton stripe": () => svgTile(16, 16, '<rect width="16" height="8" fill="#F1E8D6"/><rect y="8" width="16" height="8" fill="#1F2A44"/>'),
        "Green camo": () => {
          const r = mulberry32(5); const shapes = [];
          [["#8F7D57", 7], ["#7B8350", 8], ["#2C3120", 8]].forEach(([color, count]) => {
            for (let i = 0; i < count; i++) {
              shapes.push({ x: r() * 120, y: r() * 80, rx: 9 + r() * 15, ry: 5 + r() * 8, rot: -35 + r() * 70, color, opacity: null, margin: 26 });
            }
          });
          return scatterTile(120, 80, "#565C37", shapes);
        }
      };

      const patternImageCache = {};
      function patternImage(name) {
        if (!patternImageCache[name]) {
          patternImageCache[name] = `url("data:image/svg+xml;base64,${btoa(PATTERN_TILES[name]())}")`;
        }
        return patternImageCache[name];
      }

      function randomSign() {
        return Math.random() < 0.5 ? -1 : 1;
      }

      function swatchHtml(name, hex) {
        return `<div style="background: ${hex};"></div>`;
      }

      function combinationCard(tag, baseName, baseHex, otherName, otherHex, why) {
        return `<div class="combination-card">
          <div class="combination-colors" aria-label="${baseName} and ${otherName}">
            ${swatchHtml(baseName, baseHex)}
            ${swatchHtml(otherName, otherHex)}
          </div>
          <div class="combination-body">
            <span class="combination-tag">${tag}</span>
            <div class="combination-names">${baseName} + ${otherName}</div>
            <p class="combination-why">${why}</p>
          </div>
        </div>`;
      }

      function generateOutfits(fromSelect) {
        const select = document.getElementById("generator-select");
        const resultsEl = document.getElementById("generator-results");
        const rerollBtn = document.getElementById("generator-reroll-btn");
        const data = JSON.parse(document.getElementById("generator-data").textContent);

        if (fromSelect && !select.value) {
          resultsEl.classList.remove("show");
          rerollBtn.classList.remove("show");
          document.getElementById("pattern-preference").classList.remove("show");
          return;
        }

        const base = data.lean_toward.find((c) => c.name === select.value);
        if (!base) return;

        const [baseH, baseS, baseL] = hexToHsl(base.hex);
        // Grays have no meaningful hue, so start their wheel pairings at slate blue.
        const wheelH = baseS < 10 ? 210 : baseH;
        const wheelS = baseS < 10 ? 45 : baseS;

        // 1) Close: a nearby hue on the wheel (analogous).
        const closeH = wheelH + randomSign() * randomBetween(15, 45);
        const closeHex = hslToHex(closeH, wheelS, baseL);
        const closeName = approxColorName(((closeH % 360) + 360) % 360, wheelS, baseL);

        // 2) Contrasting: roughly opposite on the wheel (near-complementary).
        const farH = wheelH + 180 + randomSign() * randomBetween(0, 25);
        const farHex = hslToHex(farH, wheelS, baseL);
        const farName = approxColorName(((farH % 360) + 360) % 360, wheelS, baseL);

        // 3) One of this person's own accent colors, picked at random.
        const accent = data.accent_colors[Math.floor(Math.random() * data.accent_colors.length)];

        // 4) Another color from their own 8-color palette (never the same one picked).
        const others = data.lean_toward.filter((c) => c.name !== base.name);
        const other = others[Math.floor(Math.random() * others.length)];

        resultsEl.innerHTML = `<div class="combination-grid">
          ${combinationCard("Close shade", base.name, base.hex, closeName, closeHex, "A nearby hue on the color wheel for a tonal, low-contrast pairing.")}
          ${combinationCard("Contrasting shade", base.name, base.hex, farName, farHex, "Roughly opposite on the color wheel, for real contrast.")}
          ${combinationCard("Your accent", base.name, base.hex, accent.name, accent.hex, "One of your own accent colors, picked at random.")}
          ${combinationCard("From your palette", base.name, base.hex, other.name, other.hex, "Another color already in your main palette.")}
        </div>`;
        resultsEl.classList.add("show");
        rerollBtn.classList.add("show");

        const pattern = pickPattern(baseH, baseS, baseL);
        const patternBar = document.getElementById("pattern-bar");
        patternBar.style.backgroundImage = patternImage(pattern);
        patternBar.setAttribute("role", "img");
        patternBar.setAttribute("aria-label", pattern);
        document.getElementById("pattern-caption").textContent =
          `Pattern suggestion for ${base.name}: ${pattern}.`;
        document.getElementById("pattern-preference").classList.add("show");
      }
    </script>

  <% else %>
    <p class="page-subtitle">Answer a few questions and get a color palette built around you.</p>
    <div id="questionnaire">
      <%= render "form", style_profile: @style_profile || StyleProfile.new %>
    </div>
  <% end %>
</div>
