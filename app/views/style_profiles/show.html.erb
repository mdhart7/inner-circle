<style>
  .nav-bar {
    display: flex; justify-content: flex-start; align-items: center;
    padding: 20px; border-bottom: 1px solid #333; background-color: #000;
    position: sticky; top: 0; z-index: 100;
  }
  .nav-btn {
    background: none;
    border: none;
    color: #999;
    cursor: pointer;
    font-size: 14px;
    text-decoration: none;
  }
  .nav-btn:hover {
    color: #fff;
  }

  .inner-container { max-width: 600px; margin: 0 auto; padding: 20px; }
  .page-title { font-size: 26px; font-weight: 700; margin-bottom: 4px; }
  .page-subtitle { color: #999; margin-bottom: 25px; }

  .style-box {
    background: #111; border: 1px solid #333; padding: 20px;
    border-radius: 20px; margin-bottom: 20px;
  }
  .style-box h3 { margin-top: 0; }

  .qfield { margin-bottom: 20px; }
  .qfield legend { font-weight: 600; margin-bottom: 8px; }
  .qhelp { color: #888; font-size: 13px; margin: 0 0 10px; }
  .qoptions { display: flex; flex-wrap: wrap; gap: 8px; }
  .qoption {
    background: #1a1a1a; border: 1px solid #333; color: #fff;
    padding: 10px 16px; border-radius: 12px; cursor: pointer; font-size: 14px;
  }
  .qoption input { position: absolute; opacity: 0; pointer-events: none; }
  .qoption:has(input:checked) { border-color: #00bfff; background: #003a4d; }

  select.style-select {
    width: 100%; padding: 12px; border-radius: 12px; border: 1px solid #444;
    background: #1a1a1a; color: #fff; font-size: 16px;
  }

  .style-submit-btn {
    width: 100%; padding: 14px; border-radius: 12px; background: #00bfff;
    border: none; font-weight: 700; font-size: 16px; margin-top: 10px; cursor: pointer;
  }

  .swatch-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin-top: 14px; }
  .swatch { border-radius: 14px; overflow: hidden; border: 1px solid #333; background: #1a1a1a; }
  .swatch .fill { height: 70px; }
  .swatch .body { padding: 8px 10px 10px; font-size: 13px; }
  .swatch .body b { display: block; font-size: 14px; }
  .swatch .hex { color: #888; font-size: 11px; }
  .swatch .why { color: #aaa; margin-top: 4px; }
  .combination-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin-top: 14px; }
  .combination-card { overflow: hidden; border: 1px solid #333; border-radius: 14px; background: #1a1a1a; }
  .combination-colors { display: grid; grid-template-columns: 1fr 1fr; height: 76px; }
  .combination-colors div { min-width: 0; }
  .combination-body { padding: 10px; font-size: 13px; }
  .combination-names { font-weight: 700; }
  .combination-why { color: #aaa; margin-top: 5px; }
  .metal-preference { margin: 14px 0 24px; }
  .metal-bar { display: flex; width: 100%; height: 36px; overflow: hidden; border: 1px solid #444; border-radius: 10px; }
  .metal-bar-gold, .metal-bar-silver { display: flex; align-items: center; justify-content: center; color: #111; font-size: 12px; font-weight: 700; white-space: nowrap; }
  .metal-bar-gold { background: #C8A24A; }
  .metal-bar-silver { background: #C0C3C7; }
  .metal-caption { color: #aaa; font-size: 13px; margin-top: 7px; }
  .outfit-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 12px; margin-top: 14px; }
  .outfit-card { overflow: hidden; border: 1px solid #333; border-radius: 14px; background: #1a1a1a; }
  .outfit-swatches { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .outfit-color { min-width: 0; }
  .outfit-color-fill { height: 64px; }
  .outfit-color-info { padding: 8px; font-size: 12px; overflow-wrap: anywhere; }
  .outfit-color-info strong { display: block; color: #fff; }
  .outfit-color-info span { color: #aaa; }
  .outfit-why { color: #aaa; font-size: 13px; padding: 0 10px 10px; }

  .retake-link { color: #00bfff; font-size: 14px; text-decoration: none; }
</style>

<div class="nav-bar">
  <%= link_to root_path, class: "nav-btn" do %>
    <i class="fa-solid fa-arrow-left"></i> Back to Feed
  <% end %>
</div>

<div class="inner-container">
  <h1 class="page-title">Your Style</h1>

  <% if @style_profile&.persisted? %>
    <p class="page-subtitle">
      Based on your questionnaire answers.
      <%= link_to "Retake", "#", class: "retake-link", onclick: "document.getElementById('questionnaire').hidden = false; document.getElementById('results').hidden = true; return false;" %>
    </p>

    <% palette = @style_profile.palette %>
    <div id="results">
      <div class="style-box">
        <p><%= palette.summary %></p>
        <% if palette.eye_line %>
          <p><%= palette.eye_line %></p>
        <% end %>
      </div>

      <h3>Lean toward</h3>
      <% if palette.lean_toward_intro %>
        <p class="page-subtitle"><%= palette.lean_toward_intro %></p>
      <% end %>
      <div class="swatch-grid">
        <% palette.lean_toward.each_with_index do |s, i| %>
          <div class="swatch">
            <div class="fill" style="background: <%= s.hex %>;"></div>
            <div class="body">
              <b><%= i + 1 %>. <%= s.name %></b>
              <span class="hex"><%= s.hex %></span>
              <p class="why"><%= s.why %></p>
            </div>
          </div>
        <% end %>
      </div>

      <h3>Accent colors</h3>
      <div class="swatch-grid">
        <% palette.accent_colors.each do |s| %>
          <div class="swatch">
            <div class="fill" style="background: <%= s.hex %>;"></div>
            <div class="body"><b><%= s.name %></b><span class="hex"><%= s.hex %></span></div>
          </div>
        <% end %>
      </div>

      <% gold_percentage = palette.gold_metal_percentage %>
      <% silver_percentage = 100 - gold_percentage %>
      <h3>Jewelry metals</h3>
      <div class="metal-preference">
        <div class="metal-bar" role="img" aria-label="<%= palette.metal_preference %>">
          <% if gold_percentage.positive? %>
            <div class="metal-bar-gold" style="width: <%= gold_percentage %>%;">
              <%= "Gold #{gold_percentage}%" if gold_percentage > 0 %>
            </div>
          <% end %>
          <% if silver_percentage.positive? %>
            <div class="metal-bar-silver" style="width: <%= silver_percentage %>%;">
              <%= "Silver #{silver_percentage}%" if silver_percentage > 0 %>
            </div>
          <% end %>
        </div>
        <p class="metal-caption"><%= palette.metal_preference %> based on your undertone.</p>
      </div>

      <h3>Top color combinations</h3>
      <div class="combination-grid">
        <% palette.color_combinations.each do |combination| %>
          <div class="combination-card">
            <div class="combination-colors" aria-label="<%= "#{combination.primary.name} and #{combination.accent.name}" %>">
              <div style="background: <%= combination.primary.hex %>;"></div>
              <div style="background: <%= combination.accent.hex %>;"></div>
            </div>
            <div class="combination-body">
              <div class="combination-names"><%= combination.primary.name %> + <%= combination.accent.name %></div>
              <p class="combination-why"><%= combination.why %></p>
            </div>
          </div>
        <% end %>
      </div>

      <h3>Lean away</h3>
      <% if palette.lean_away_intro %>
        <p class="page-subtitle"><%= palette.lean_away_intro %></p>
      <% end %>
      <div class="swatch-grid">
        <% palette.lean_away.each do |s| %>
          <div class="swatch">
            <% if s.hex %>
              <div class="fill" style="background: <%= s.hex %>;"></div>
            <% end %>
            <div class="body">
              <b><%= s.name %></b>
              <% if s.hex %>
                <span class="hex"><%= s.hex %></span>
              <% end %>
              <p class="why"><%= s.why %></p>
            </div>
          </div>
        <% end %>
      </div>

      <h3>Outfit recommendations</h3>
      <p class="page-subtitle">Four color combinations picked for your profile.</p>
      <div class="outfit-grid">
        <% palette.outfit_combinations.each_with_index do |outfit, index| %>
          <div class="outfit-card">
            <div class="outfit-swatches">
              <% [ [ "Top", outfit.top ], [ "Pants", outfit.bottom ], [ "Shoes", outfit.shoes ] ].each do |label, swatch| %>
                <div class="outfit-color">
                  <div class="outfit-color-fill" style="background: <%= swatch.hex %>;" aria-label="<%= "#{label}: #{swatch.name}" %>"></div>
                  <div class="outfit-color-info">
                    <strong><%= label %></strong>
                    <span><%= swatch.name %></span>
                  </div>
                </div>
              <% end %>
            </div>
            <p class="outfit-why"><strong>Look <%= index + 1 %>:</strong> <%= outfit.why %></p>
          </div>
        <% end %>
      </div>
    </div>

    <div id="questionnaire" hidden>
      <%= render "form", style_profile: @style_profile %>
    </div>

  <% else %>
    <p class="page-subtitle">Answer a few questions and get a color palette built around you.</p>
    <div id="questionnaire">
      <%= render "form", style_profile: @style_profile || StyleProfile.new %>
    </div>
  <% end %>
</div>
