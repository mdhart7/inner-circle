<style>
  .nav-bar {
    display: flex; justify-content: flex-start; align-items: center;
    padding: 20px; border-bottom: 1px solid #333; background-color: #000;
    position: sticky; top: 0; z-index: 100;
  }
  .nav-btn {
    background: none;
    border: none;
    color: #999;
    cursor: pointer;
    font-size: 14px;
    text-decoration: none;
  }
  .nav-btn:hover {
    color: #fff;
  }

  .inner-container { max-width: 600px; margin: 0 auto; padding: 20px; }
  .page-title { font-size: 26px; font-weight: 700; margin-bottom: 4px; }
  .page-subtitle { color: #999; margin-bottom: 25px; }

  .style-box {
    background: #111; border: 1px solid #333; padding: 20px;
    border-radius: 20px; margin-bottom: 20px;
  }
  .style-box h3 { margin-top: 0; }

  .qfield { margin-bottom: 20px; }
  .qfield legend { font-weight: 600; margin-bottom: 8px; }
  .qhelp { color: #888; font-size: 13px; margin: 0 0 10px; }
  .qoptions { display: flex; flex-wrap: wrap; gap: 8px; }
  .qoption {
    background: #1a1a1a; border: 1px solid #333; color: #fff;
    padding: 10px 16px; border-radius: 12px; cursor: pointer; font-size: 14px;
  }
  .qoption input { position: absolute; opacity: 0; pointer-events: none; }
  .qoption:has(input:checked) { border-color: #00bfff; background: #003a4d; }

  select.style-select {
    width: 100%; padding: 12px; border-radius: 12px; border: 1px solid #444;
    background: #1a1a1a; color: #fff; font-size: 16px;
  }

  .style-submit-btn {
    width: 100%; padding: 14px; border-radius: 12px; background: #00bfff;
    border: none; font-weight: 700; font-size: 16px; margin-top: 10px; cursor: pointer;
  }

  .swatch-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 12px; margin-top: 14px; }
  .swatch { border-radius: 14px; overflow: hidden; border: 1px solid #333; background: #1a1a1a; }
  .swatch .fill { height: 70px; }
  .swatch .body { padding: 8px 10px 10px; font-size: 13px; }
  .swatch .body b { display: block; font-size: 14px; }
  .swatch .hex { color: #888; font-size: 11px; }
  .swatch .why { color: #aaa; margin-top: 4px; }
  .combination-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; margin-top: 14px; }
  .combination-card { overflow: hidden; border: 1px solid #333; border-radius: 14px; background: #1a1a1a; }
  .combination-colors { display: grid; grid-template-columns: 1fr 1fr; height: 76px; }
  .combination-colors div { min-width: 0; }
  .combination-body { padding: 10px; font-size: 13px; }
  .combination-names { font-weight: 700; }
  .combination-why { color: #aaa; margin-top: 5px; }
  .combination-tag { display: inline-block; color: #00bfff; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.03em; margin-bottom: 4px; }
  .metal-preference { margin: 14px 0 24px; }
  .metal-bar { display: flex; width: 100%; height: 36px; overflow: hidden; border: 1px solid #444; border-radius: 10px; }
  .metal-bar-gold, .metal-bar-silver { display: flex; align-items: center; justify-content: center; color: #111; font-size: 12px; font-weight: 700; white-space: nowrap; }
  .metal-bar-gold { background: #C8A24A; }
  .metal-bar-silver { background: #C0C3C7; }
  .metal-caption { color: #aaa; font-size: 13px; margin-top: 7px; }
  .retake-link { color: #00bfff; font-size: 14px; text-decoration: none; }

  .generator-box {
    background: #111; border: 1px solid #333; border-radius: 20px;
    padding: 16px; margin-top: 24px;
  }
  .generator-box label { font-weight: 600; display: block; margin-bottom: 8px; }
  .generator-select {
    width: 100%; padding: 12px; border-radius: 12px; border: 1px solid #444;
    background: #1a1a1a; color: #fff; font-size: 16px; box-sizing: border-box;
  }
  .generator-hint { color: #888; font-size: 12px; margin-top: 6px; }
  .generator-reroll-btn {
    width: 100%; padding: 12px; border-radius: 12px; background: #1a1a1a;
    border: 1px solid #00bfff; color: #00bfff; font-weight: 700; font-size: 14px;
    margin-top: 12px; cursor: pointer; display: none;
  }
  .generator-reroll-btn.show { display: block; }
  .generator-results { margin-top: 16px; display: none; }
  .generator-results.show { display: block; }
</style>

<div class="nav-bar">
  <%= link_to root_path, class: "nav-btn" do %>
    <i class="fa-solid fa-arrow-left"></i> Back to Feed
  <% end %>
</div>

<div class="inner-container">
  <h1 class="page-title">Your Style</h1>

  <% if @style_profile&.persisted? %>
    <p class="page-subtitle">
      Based on your questionnaire answers.
      <%= link_to "Retake", "#", class: "retake-link", onclick: "document.getElementById('questionnaire').hidden = false; document.getElementById('results').hidden = true; return false;" %>
    </p>

    <% palette = @style_profile.palette %>
    <div id="results">
      <div class="style-box">
        <p><%= palette.summary %></p>
        <% if palette.eye_line %>
          <p><%= palette.eye_line %></p>
        <% end %>
      </div>

      <h3>Lean toward</h3>
      <% if palette.lean_toward_intro %>
        <p class="page-subtitle"><%= palette.lean_toward_intro %></p>
      <% end %>
      <div class="swatch-grid">
        <% palette.lean_toward.each_with_index do |s, i| %>
          <div class="swatch">
            <div class="fill" style="background: <%= s.hex %>;"></div>
            <div class="body">
              <b><%= i + 1 %>. <%= s.name %></b>
              <span class="hex"><%= s.hex %></span>
              <p class="why"><%= s.why %></p>
            </div>
          </div>
        <% end %>
      </div>

      <h3>Accent colors</h3>
      <div class="swatch-grid">
        <% palette.accent_colors.each do |s| %>
          <div class="swatch">
            <div class="fill" style="background: <%= s.hex %>;"></div>
            <div class="body"><b><%= s.name %></b><span class="hex"><%= s.hex %></span></div>
          </div>
        <% end %>
      </div>

      <% gold_percentage = palette.gold_metal_percentage %>
      <% silver_percentage = 100 - gold_percentage %>
      <h3>Jewelry metals</h3>
      <div class="metal-preference">
        <div class="metal-bar" role="img" aria-label="<%= palette.metal_preference %>">
          <% if gold_percentage.positive? %>
            <div class="metal-bar-gold" style="width: <%= gold_percentage %>%;"></div>
          <% end %>
          <% if silver_percentage.positive? %>
            <div class="metal-bar-silver" style="width: <%= silver_percentage %>%;"></div>
          <% end %>
        </div>
        <p class="metal-caption"><%= palette.metal_preference %> based on your undertone.</p>
      </div>

      <h3>Lean away</h3>
      <% if palette.lean_away_intro %>
        <p class="page-subtitle"><%= palette.lean_away_intro %></p>
      <% end %>
      <div class="swatch-grid">
        <% palette.lean_away.each do |s| %>
          <div class="swatch">
            <% if s.hex %>
              <div class="fill" style="background: <%= s.hex %>;"></div>
            <% end %>
            <div class="body">
              <b><%= s.name %></b>
              <% if s.hex %>
                <span class="hex"><%= s.hex %></span>
              <% end %>
              <p class="why"><%= s.why %></p>
            </div>
          </div>
        <% end %>
      </div>

      <h3>Outfit generator</h3>
      <div class="generator-box">
        <label for="generator-select">Pick one of your 8 main colors</label>
        <select id="generator-select" class="generator-select" onchange="generateOutfits(true)">
          <option value="">Choose a color...</option>
          <% palette.lean_toward.each do |c| %>
            <option value="<%= c.name %>"><%= c.name %></option>
          <% end %>
        </select>
        <p class="generator-hint">
          Generates 4 random pairings: a close shade, a contrasting shade, one of your accent colors,
          and another color from your palette. Not limited to your palette's exact hexes for the
          close/contrasting shades &mdash; those pull from anywhere on the color wheel.
        </p>
        <button type="button" class="generator-reroll-btn" id="generator-reroll-btn" onclick="generateOutfits(false)">
          Generate another set
        </button>
        <div class="generator-results" id="generator-results"></div>
      </div>
    </div>

    <div id="questionnaire" hidden>
      <%= render "form", style_profile: @style_profile %>
    </div>

    <script type="application/json" id="generator-data"><%== raw(
      {
        lean_toward: palette.lean_toward.map { |c| { name: c.name, hex: c.hex } },
        accent_colors: palette.accent_colors.map { |c| { name: c.name, hex: c.hex } }
      }.to_json
    ) %></script>

    <script>
      // -- hex <-> HSL, so "close" and "contrasting" shades can come from
      // anywhere on the color wheel, not just this person's own swatches.
      function hexToHsl(hex) {
        const r = parseInt(hex.slice(1, 3), 16) / 255;
        const g = parseInt(hex.slice(3, 5), 16) / 255;
        const b = parseInt(hex.slice(5, 7), 16) / 255;
        const max = Math.max(r, g, b), min = Math.min(r, g, b);
        let h, s;
        const l = (max + min) / 2;
        if (max === min) {
          h = s = 0;
        } else {
          const d = max - min;
          s = l > 0.5 ? d / (2 - max - min) : d / (max + min);
          switch (max) {
            case r: h = (g - b) / d + (g < b ? 6 : 0); break;
            case g: h = (b - r) / d + 2; break;
            default: h = (r - g) / d + 4;
          }
          h /= 6;
        }
        return [h * 360, s * 100, l * 100];
      }

      function hslToHex(h, s, l) {
        h = ((h % 360) + 360) % 360;
        s = Math.min(100, Math.max(0, s)) / 100;
        l = Math.min(100, Math.max(0, l)) / 100;
        const c = (1 - Math.abs(2 * l - 1)) * s;
        const x = c * (1 - Math.abs(((h / 60) % 2) - 1));
        const m = l - c / 2;
        let r, g, b;
        if (h < 60) [r, g, b] = [c, x, 0];
        else if (h < 120) [r, g, b] = [x, c, 0];
        else if (h < 180) [r, g, b] = [0, c, x];
        else if (h < 240) [r, g, b] = [0, x, c];
        else if (h < 300) [r, g, b] = [x, 0, c];
        else [r, g, b] = [c, 0, x];
        const toHex = (v) => Math.round((v + m) * 255).toString(16).padStart(2, "0");
        return `#${toHex(r)}${toHex(g)}${toHex(b)}`;
      }

      // Rough, procedural naming for colors generated on the fly (not from
      // this person's curated swatches), so results still show a label
      // instead of just a hex code.
      function approxColorName(h, s, l) {
        const hues = [
          [15, "Red"], [45, "Orange"], [70, "Amber"], [90, "Yellow"], [150, "Green"],
          [180, "Teal"], [210, "Cyan"], [240, "Blue"], [270, "Indigo"], [300, "Purple"],
          [330, "Magenta"], [360, "Red"]
        ];
        let base = "Red";
        for (const [max, label] of hues) {
          if (h <= max) { base = label; break; }
        }
        const lightnessWord = l < 25 ? "Deep " : l > 78 ? "Pale " : l > 60 ? "Light " : "";
        const satWord = s < 28 ? "Muted " : "";
        return `${lightnessWord}${satWord}${base}`.trim();
      }

      function randomBetween(min, max) {
        return min + Math.random() * (max - min);
      }

      function randomSign() {
        return Math.random() < 0.5 ? -1 : 1;
      }

      function swatchHtml(name, hex) {
        return `<div style="background: ${hex};"></div>`;
      }

      function combinationCard(tag, baseName, baseHex, otherName, otherHex, why) {
        return `<div class="combination-card">
          <div class="combination-colors" aria-label="${baseName} and ${otherName}">
            ${swatchHtml(baseName, baseHex)}
            ${swatchHtml(otherName, otherHex)}
          </div>
          <div class="combination-body">
            <span class="combination-tag">${tag}</span>
            <div class="combination-names">${baseName} + ${otherName}</div>
            <p class="combination-why">${why}</p>
          </div>
        </div>`;
      }

      function generateOutfits(fromSelect) {
        const select = document.getElementById("generator-select");
        const resultsEl = document.getElementById("generator-results");
        const rerollBtn = document.getElementById("generator-reroll-btn");
        const data = JSON.parse(document.getElementById("generator-data").textContent);

        if (fromSelect && !select.value) {
          resultsEl.classList.remove("show");
          rerollBtn.classList.remove("show");
          return;
        }

        const base = data.lean_toward.find((c) => c.name === select.value);
        if (!base) return;

        const [baseH, baseS, baseL] = hexToHsl(base.hex);
        // Grays have no meaningful hue, so start their wheel pairings at slate blue.
        const wheelH = baseS < 10 ? 210 : baseH;
        const wheelS = baseS < 10 ? 45 : baseS;

        // 1) Close: a nearby hue on the wheel (analogous).
        const closeH = wheelH + randomSign() * randomBetween(15, 45);
        const closeHex = hslToHex(closeH, wheelS, baseL);
        const closeName = approxColorName(((closeH % 360) + 360) % 360, wheelS, baseL);

        // 2) Contrasting: roughly opposite on the wheel (near-complementary).
        const farH = wheelH + 180 + randomSign() * randomBetween(0, 25);
        const farHex = hslToHex(farH, wheelS, baseL);
        const farName = approxColorName(((farH % 360) + 360) % 360, wheelS, baseL);

        // 3) One of this person's own accent colors, picked at random.
        const accent = data.accent_colors[Math.floor(Math.random() * data.accent_colors.length)];

        // 4) Another color from their own 8-color palette (never the same one picked).
        const others = data.lean_toward.filter((c) => c.name !== base.name);
        const other = others[Math.floor(Math.random() * others.length)];

        resultsEl.innerHTML = `<div class="combination-grid">
          ${combinationCard("Close shade", base.name, base.hex, closeName, closeHex, "A nearby hue on the color wheel for a tonal, low-contrast pairing.")}
          ${combinationCard("Contrasting shade", base.name, base.hex, farName, farHex, "Roughly opposite on the color wheel, for real contrast.")}
          ${combinationCard("Your accent", base.name, base.hex, accent.name, accent.hex, "One of your own accent colors, picked at random.")}
          ${combinationCard("From your palette", base.name, base.hex, other.name, other.hex, "Another color already in your main palette.")}
        </div>`;
        resultsEl.classList.add("show");
        rerollBtn.classList.add("show");
      }
    </script>

  <% else %>
    <p class="page-subtitle">Answer a few questions and get a color palette built around you.</p>
    <div id="questionnaire">
      <%= render "form", style_profile: @style_profile || StyleProfile.new %>
    </div>
  <% end %>
</div>
