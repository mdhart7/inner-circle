<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    background-color: #000 !important; color: #fff !important;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif !important;
    min-height: 100vh;
  }

  .nav-bar {
    display: flex; justify-content: space-between; align-items: center;
    padding: 20px; border-bottom: 1px solid #333;
    background-color: #000; position: sticky; top: 0; z-index: 100;
  }
  .nav-links { display: flex; gap: 20px; align-items: center; }
  .nav-btn {
    color: #999; text-decoration: none; font-size: 14px;
    display: inline-flex; gap: 6px; align-items: center;
  }
  .nav-btn:hover { color: #fff; }

  .login-btn {
    background-color: #00bfff; color: #000; padding: 8px 20px;
    border-radius: 6px; font-weight: 600; text-decoration: none;
  }

  .inner-container { max-width: 600px; margin: 20px auto; padding: 20px; }
  
.page-subtitle {
  margin-bottom: 25px;
}

.upload-box {
  background-color: #1a1a1a;
  border: 2px dashed #444;
  border-radius: 20px;
  padding: 40px 20px;
  margin: 0 auto 30px auto;
  width: 90%;
  max-width: 500px;
  text-align: center;
  cursor: pointer;
  display: block;
  transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
}

.upload-box:hover,
.upload-box:focus-within {
  background-color: #333;
  border-color: #00bfff;
}

.upload-box:active {
  background-color: #444;
  transform: scale(0.99);
}

.upload-icon-emoji {
  font-size: 50px;
  margin-bottom: 10px;
}

.upload-text {
  color: #bbb;
  font-size: 16px;
}

.post-btn {
  width: 90%;
  max-width: 500px;
  padding: 15px;
  margin: 0 auto 20px auto;
  background-color: #1a1a1a;
  border: 1px solid #333;
  border-radius: 20px;
  color: #fff;
  font-size: 18px;
  font-weight: 600;
  display: block;
  cursor: pointer;
  transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
}
.post-btn:hover,
.post-btn:focus-visible {
  background-color: #333;
  border-color: #00bfff;
}
.post-btn:active {
  background-color: #444;
  transform: scale(0.99);
}


  .photo-card {
    background-color: #1a1a1a; border-radius: 12px; padding: 20px; margin-bottom: 20px;
    border: 1px solid #222; position: relative;
  }
  .uploaded-image { width: 100%; border-radius: 8px; margin-bottom: 15px; }

  .delete-photo-btn {
    position: absolute; top: 15px; right: 15px; background-color: red;
    width: 35px; height: 35px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    color: #fff; font-size: 16px; border: none;
  }

  .vote-section { display: flex; justify-content: space-between; margin-top: 15px; }
  .vote-buttons { display: flex; gap: 10px; flex: 1; }
  .vote-btn {
    flex: 1; padding: 15px; border-radius: 8px; border: none;
    font-size: 20px; font-weight: 700; cursor: pointer;
  }
  .vote-yes { background-color: #00ff00; color: #000; }
  .vote-no { background-color: #ff0000; color: #fff; }

  .vote-count {
    background-color: #222; padding: 10px 15px;
    border-radius: 8px; text-align: center; font-size: 14px;
  }

  .carousel { overflow: hidden; }
  .carousel-track {
    display: flex; width: 100%; overflow-x: auto; scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch; scrollbar-width: none;
  }
  .carousel-track::-webkit-scrollbar { display: none; }
  .carousel-slide {
    flex: 0 0 100%; min-width: 100%; width: 100%; box-sizing: border-box;
    scroll-snap-align: start; border-right: 8px solid #000;
  }
  .carousel-slide:last-child { border-right: none; }
  .slide-image-wrapper { position: relative; }
  .carousel-arrow {
    position: absolute; top: 50%; transform: translateY(-50%);
    background-color: rgba(0, 0, 0, 0.55); color: #fff; border: none;
    width: 34px; height: 34px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    cursor: pointer; font-size: 15px; z-index: 5;
  }
  .carousel-arrow:hover { background-color: rgba(0, 0, 0, 0.8); }
  .carousel-arrow.prev { left: 10px; }
  .carousel-arrow.next { right: 10px; }
  .carousel-dots { display: flex; justify-content: center; gap: 6px; margin-top: 12px; }
  .dot {
    width: 6px; height: 6px; border-radius: 50%; background-color: #444;
    transition: background-color 0.2s ease;
  }
  .dot.active { background-color: #00bfff; }
  .comments-section { margin-top: 15px; }
  .comments-list { display: flex; flex-direction: column; gap: 6px; margin-bottom: 10px; }
  .comment { font-size: 14px; color: #ddd; }
  .comment strong { color: #fff; }
  .comment-form { display: flex; gap: 8px; }
  .comment-input {
    flex: 1; padding: 10px; background-color: #222; border: 1px solid #333;
    border-radius: 8px; color: #fff; font-size: 14px;
  }
  .comment-submit {
    background-color: #00bfff; color: #000; border: none; border-radius: 8px;
    padding: 0 16px; font-weight: 600; cursor: pointer;
  }
</style>

<div class="nav-bar">
  <div class="nav-links">
    <%= link_to root_path, class: "nav-btn" do %>
      <i class="fa-solid fa-house"></i> Home
    <% end %>

    <%= link_to circle_path, class: "nav-btn" do %>
      <i class="fa-solid fa-users"></i> My Circle
    <% end %>

    <%= link_to "/stylist", class: "nav-btn" do %>
      <i class="fa-solid fa-wand-magic-sparkles"></i> Ask Milo
    <% end %>

    <%= link_to "https://instagram.com", class: "nav-btn", target: "_blank" do %>
      <i class="fa-brands fa-instagram"></i> Ready to Post
    <% end %>
  </div>

  <% if user_signed_in? %>
    <%= link_to destroy_user_session_path, method: :delete, class: "login-btn" do %>
      Logout
    <% end %>
  <% else %>
    <%= link_to new_user_session_path, class: "login-btn" do %>
      Login
    <% end %>
  <% end %>
</div>

<div class="inner-container">

  <h1 class="page-title">Inner Circle</h1>
  <p class="page-subtitle">Ask Your Inner Circle First</p>


  <% if user_signed_in? %>
    <%= form_with url: posts_path, method: :post, local: true, html: { multipart: true } do %>

      <label class="upload-box">
        <div class="upload-icon-emoji">📸</div>
        <div class="upload-text">Tap to Upload</div>
        <%= file_field_tag "query_images[]", multiple: true, accept: "image/*", style: "display:none;", id: "query-images-input" %>
      </label>

      <button type="submit" class="post-btn">See What Your People Think </button>

    <% end %>
  <% else %>
    <div class="upload-box" onclick="alert('Please sign in to upload')">
      <div class="upload-icon-emoji">📸</div>
      <div class="upload-text">Sign in to upload</div>
    </div>
  <% end %>

  <h2 class="feed-header"> Feed</h2>

  <% @polls.each do |poll| %>
    <div class="photo-card" data-poll-id="<%= poll.id %>">

      <% if poll.user_id == current_user&.id %>
        <%= link_to post_path(poll.posts.first), method: :delete, class: "delete-photo-btn",
            data: { confirm: "Delete this post?" } do %>
          <i class="fa-solid fa-trash"></i>
        <% end %>
      <% end %>

      <div class="carousel">
        <div class="carousel-track">
          <% poll.posts.each do |post| %>
            <div class="carousel-slide">
              <div class="slide-image-wrapper">
                <% if post.image.present? %>
                  <%= image_tag post.image.url, class: "uploaded-image" %>
                <% end %>
                <% if poll.carousel? %>
                  <% unless post == poll.posts.first %>
                    <button type="button" class="carousel-arrow prev" onclick="scrollCarousel(this, -1)" aria-label="Previous photo">
                      <i class="fa-solid fa-chevron-left"></i>
                    </button>
                  <% end %>
                  <% unless post == poll.posts.last %>
                    <button type="button" class="carousel-arrow next" onclick="scrollCarousel(this, 1)" aria-label="Next photo">
                      <i class="fa-solid fa-chevron-right"></i>
                    </button>
                  <% end %>
                <% end %>
              </div>
              <p class="permanent-caption">This Hard?</p>

              <div class="vote-section">
                <div class="vote-buttons">
                  <button class="vote-btn vote-yes" onclick="vote(<%= post.id %>, 'yes')"></button>
                  <button class="vote-btn vote-no" onclick="vote(<%= post.id %>, 'no')"></button>
                </div>

                <div class="vote-count">
                  <span id="count-<%= post.id %>" class="count-number"><%= post.total_votes_count %></span>
                  <div class="vote-breakdown">
                    <span id="yes-<%= post.id %>"><%= post.yes_votes_count %></span> yes •
                    <span id="no-<%= post.id %>"><%= post.no_votes_count %></span> no
                  </div>
                  <div id="status-<%= post.id %>" class="vote-status">
                    <% if current_user %>
                      <% vote = post.user_vote(current_user) %>
                      <% if vote %>
                        You voted <%= vote.vote_type == "yes" ? "yes" : "no" %>
                      <% end %>
                    <% end %>
                  </div>
                </div>
              </div>

              <div class="comments-section">
                <div class="comments-list" id="comments-<%= post.id %>">
                  <% post.comments.each do |comment| %>
                    <div class="comment"><strong><%= comment.user.full_name %>:</strong> <%= comment.body %></div>
                  <% end %>
                </div>
                <% if user_signed_in? %>
                  <form class="comment-form" onsubmit="return submitComment(event, <%= post.id %>)">
                    <input type="text" class="comment-input" id="comment-input-<%= post.id %>"
                           placeholder="Add a comment..." maxlength="300">
                    <button type="submit" class="comment-submit">Post</button>
                  </form>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
        <% if poll.carousel? %>
          <div class="carousel-dots">
            <% poll.posts.each_with_index do |_post, i| %>
              <span class="dot <%= "active" if i.zero? %>"></span>
            <% end %>
          </div>
        <% end %>
      </div>
      <div class="post-author">Posted by <%= poll.user.full_name %></div>
    </div>
  <% end %>

</div>


<script>
  async function vote(postId, voteType) {
    try {
      const response = await fetch(`/posts/${postId}/vote`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]').content
        },
        body: JSON.stringify({ vote_type: voteType })
      });

      const data = await response.json();

      document.getElementById(`count-${postId}`).textContent = data.total_count;
      document.getElementById(`yes-${postId}`).textContent = data.yes_count;
      document.getElementById(`no-${postId}`).textContent = data.no_count;

      document.getElementById(`status-${postId}`).textContent =
        data.user_vote ? `You voted ${data.user_vote === 'yes' ? '✅' : '❌'}` : '';
    } catch (err) {
      alert("Vote failed — try again.");
    }
  }

  function scrollCarousel(button, direction) {
    const track = button.closest(".carousel").querySelector(".carousel-track");
    track.scrollBy({ left: direction * track.clientWidth, behavior: "smooth" });
  }

  document.querySelectorAll(".carousel-track").forEach((track) => {
    const dots = track.closest(".carousel").querySelectorAll(".dot");
    if (!dots.length) return;
    track.addEventListener("scroll", () => {
      const index = Math.round(track.scrollLeft / track.clientWidth);
      dots.forEach((dot, i) => dot.classList.toggle("active", i === index));
    }, { passive: true });
  });

  const imagesInput = document.getElementById("query-images-input");
  if (imagesInput) {
    imagesInput.addEventListener("change", () => {
      const label = imagesInput.closest(".upload-box").querySelector(".upload-text");
      const count = imagesInput.files.length;
      label.textContent = count === 0 ? "Tap to Upload" : count === 1 ? "1 photo selected" : `${count} photos selected`;
    });
  }

  async function submitComment(event, postId) {
    event.preventDefault();
    const input = document.getElementById(`comment-input-${postId}`);
    const body = input.value.trim();
    if (!body) return false;

    try {
      const response = await fetch(`/posts/${postId}/comments`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content
        },
        body: JSON.stringify({ body })
      });
      const data = await response.json();
      if (data.error) {
        alert(data.error);
        return false;
      }

      const wrapper = document.createElement("div");
      wrapper.className = "comment";
      const strong = document.createElement("strong");
      strong.textContent = `${data.author}: `;
      wrapper.appendChild(strong);
      wrapper.appendChild(document.createTextNode(data.body));
      document.getElementById(`comments-${postId}`).appendChild(wrapper);
      input.value = "";
    } catch (_error) {
      alert("Comment failed — try again.");
    }
    return false;
  }
</script>
