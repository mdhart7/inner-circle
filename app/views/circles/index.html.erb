<style>
.circle-add-box,
.circle-qr-box {
  background: #111;
  border: 1px solid #333;
  padding: 20px;
  border-radius: 20px;
  margin-bottom: 25px;
  text-align: center;
}

.circle-input {
  width: 90%;
  padding: 12px;
  border-radius: 12px;
  border: 1px solid #444;
  background: #1a1a1a;
  color: white;
  margin-bottom: 12px;
  font-size: 16px;
}

.circle-add-btn {
  width: 90%;
  padding: 12px;
  border-radius: 12px;
  background: #00bfff;
  border: none;
  font-weight: 600;
  font-size: 16px;
}

.invite-qr {
  margin-top: 10px;
  width: 100%;
  max-width: 140px;
  height: auto;
  aspect-ratio: 1 / 1;
}

.circle-side-by-side {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-bottom: 25px;
  align-items: stretch;
  min-height: 350px;
}

.circle-side-by-side .circle-add-box,
.circle-side-by-side .circle-qr-box {
  flex: 1 1 0;
  min-width: 0;
}

.circle-side-by-side .circle-add-box {
  display: flex;
  flex-direction: column;
}

.circle-side-by-side .circle-add-box form {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-height: 0;
}

.circle-side-by-side .circle-add-box,
.circle-side-by-side .circle-qr-box {
  margin-bottom: 0;
  padding: 14px;
}

.circle-side-by-side .circle-add-box h3,
.circle-side-by-side .circle-qr-box h3 {
  font-size: 14px;
  white-space: nowrap;
}

.circle-side-by-side .circle-input,
.circle-side-by-side .circle-add-btn {
  width: 100%;
  box-sizing: border-box;
  font-size: 13px;
  padding-left: 10px;
  padding-right: 10px;
}

.circle-side-by-side .circle-add-btn {
  font-size: 15px;
  align-self: center;
  width: min(100%, 200px);
  flex: 0 0 auto;
  min-height: 52px;
  margin-top: 32px;
}

/* Keep the cards compact when two columns are tight, then stack on the
   narrowest phones. */
@media (max-width: 600px) {
  .circle-side-by-side {
    min-height: 280px;
  }
}

@media (max-width: 380px) {
  .circle-side-by-side {
    grid-template-columns: minmax(0, 1fr);
    min-height: 0;
  }
}

.circle-member-card {
  background: #111;
  border: 1px solid #222;
  border-radius: 20px;
  padding: 15px;
  margin-bottom: 15px;
  display: flex;
  align-items: center;
  gap: 15px;
}

.member-avatar {
  width: 45px;
  height: 45px;
  border-radius: 50%;
  background: #444;
  color: #fff;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
}

.circle-remove-btn {
  margin-left: auto;
  color: #ff5555;
  font-size: 20px;
}

.nav-bar {
  display: flex;
  align-items: center;
  padding: 20px;
  border-bottom: 1px solid #333;
  background: #000;
  position: sticky;
  top: 0;
  z-index: 100;
}

.nav-btn {
  color: #999;
  font-size: 14px;
  text-decoration: none;
}

.nav-btn:hover,
.nav-btn:focus-visible {
  color: #fff;
}

.posts-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10px;
  margin-bottom: 30px;
}

.post-mini {
  background: #111;
  border: 1px solid #222;
  border-radius: 12px;
  padding: 8px;
}

.post-mini-thumbs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 3px;
}

.mini-thumb {
  position: relative;
  aspect-ratio: 1 / 1;
  border-radius: 6px;
  overflow: hidden;
  background: #222;
}

.mini-thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.mini-rank {
  position: absolute;
  top: 2px;
  left: 2px;
  background: rgba(0, 0, 0, 0.7);
  color: #fff;
  font-size: 9px;
  font-weight: 700;
  line-height: 1;
  padding: 2px 4px;
  border-radius: 4px;
}

.mini-yes {
  position: absolute;
  bottom: 2px;
  right: 2px;
  background: rgba(0, 0, 0, 0.7);
  color: #00ff00;
  font-size: 9px;
  font-weight: 700;
  line-height: 1;
  padding: 2px 4px;
  border-radius: 4px;
}

.post-mini-meta {
  margin-top: 6px;
  color: #888;
  font-size: 11px;
  text-align: center;
}
</style>


<div class="nav-bar">
  <%= link_to root_path, class: "nav-btn back-to-feed-link" do %>
    <i class="fa-solid fa-arrow-left"></i> Back to Feed
  <% end %>
</div>

<div class="inner-container">
  <h2 class="feed-header">Your Posts</h2>

  <% if @my_polls.present? %>
    <div class="posts-grid">
      <% @my_polls.each do |poll| %>
        <div class="post-mini">
          <div class="post-mini-thumbs">
            <% poll.top_posts(3).each_with_index do |post, index| %>
              <div class="mini-thumb">
                <% if post.image.present? %>
                  <img src="<%= post.thumb_url %>" alt="Top photo <%= index + 1 %>" loading="lazy"
                       onerror="this.onerror=null;this.src='<%= j post.image.url %>'">
                <% end %>
                <span class="mini-rank"><%= index + 1 %></span>
                <span class="mini-yes"><i class="fa-solid fa-check"></i> <%= post.yes_votes_count %></span>
              </div>
            <% end %>
          </div>
          <div class="post-mini-meta">
            <%= pluralize(poll.posts.size, "photo") %> · <%= poll.created_at.strftime("%b %-d") %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p style="color:#888; margin-bottom: 30px;">You haven't posted anything yet.</p>
  <% end %>

  <h1 class="page-title">My Circle</h1>
  <p class="page-subtitle">Add or invite your council</p>


  <div class="circle-side-by-side">
    <div class="circle-add-box">
      <h3>Add a friend</h3>

      <%= form_with url: circle_members_path, method: :post, local: true do %>
        <input
          type="text"
          name="identifier"
          placeholder="Username/email"
          class="circle-input"
          required
        >
        <button type="submit" class="circle-add-btn">Add</button>
      <% end %>
    </div>

    <div class="circle-qr-box">
      <h3>Invite via QR Code</h3>
      <p>Have your people scan to join</p>

      <%= image_tag(
        "https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=#{CGI.escape(new_user_registration_url)}",
        alt: "Invite QR Code",
        class: "invite-qr"
      ) %>
    </div>
  </div>

  <div class="circle-add-box">
    <h3>Share your referral link</h3>
    <p>New members who sign up through your link are added to your circle automatically.</p>
    <input id="referral-link" class="circle-input" type="text"
           value="<%= new_user_registration_url(ref: current_user.username) %>" readonly>
    <button type="button" class="circle-add-btn" onclick="copyReferralLink(this)">Copy link</button>
  </div>


<h2 class="feed-header">Your Inner Circle</h2>

<% if @circle_members.present? %>
  <% @circle_members.each do |relationship| %>
    <% member = relationship.member %>

    <div class="circle-member-card">
      <div class="member-avatar"><%= member.initials %></div>

      <div class="member-info">
        <strong><%= member.full_name %></strong><br>
        <span>@<%= member.username %></span>
      </div>

      <%= link_to circle_member_path(relationship),
            method: :delete,
            data: { confirm: "Remove #{member.full_name} from your circle?" },
            class: "circle-remove-btn" do %>
        <i class="fa-solid fa-user-minus"></i>
      <% end %>
    </div>

  <% end %>
<% else %>
  <p style="color:#888;">You haven't added anyone yet.</p>
<% end %>


<h2 class="feed-header">Incoming Requests</h2>

<% if @incoming_requests.present? %>
  <% @incoming_requests.each do |req| %>
    <div class="circle-member-card">
      <div class="member-avatar"><%= req.user.initials %></div>

      <div class="member-info">
        <strong><%= req.user.full_name %></strong><br>
        <span>@<%= req.user.username %></span>
      </div>

      <%= link_to "Accept",
          accept_circle_member_path(req),
          method: :patch,
          class: "circle-remove-btn",
          data: { confirm: "Accept this request?" } %>
    </div>

  <% end %>
<% else %>
  <p style="color:#888;">No pending requests.</p>
<% end %>

</div>

<script>
  function legacyCopy(link) {
    link.removeAttribute("readonly");
    link.focus();
    link.select();
    link.setSelectionRange(0, 99999);
    const copied = document.execCommand("copy");
    link.setAttribute("readonly", true);
    return copied;
  }

  async function copyReferralLink(button) {
    const link = document.getElementById("referral-link");

    if (legacyCopy(link)) {
      button.textContent = "Copied!";
      setTimeout(() => button.textContent = "Copy link", 1500);
      return;
    }

    if (navigator.clipboard && window.isSecureContext) {
      try {
        await navigator.clipboard.writeText(link.value);
        button.textContent = "Copied!";
        setTimeout(() => button.textContent = "Copy link", 1500);
        return;
      } catch (error) {
        console.error("Clipboard API copy failed:", error);
      }
    }

    button.textContent = "Select and copy";
    link.focus();
    link.select();
    link.setSelectionRange(0, 99999);
  }
</script>
