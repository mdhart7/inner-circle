<style>
  .nav-bar {
    display: flex; align-items: center; padding: 20px;
    border-bottom: 1px solid #333; background: #000;
    position: sticky; top: 0; z-index: 100;
  }
  .nav-btn { color: #999; font-size: 14px; text-decoration: none; }
  .nav-btn:hover { color: #fff; }
  .shared-post {
    max-width: 600px; margin: 20px auto; padding: 20px;
    background: #1a1a1a; border: 1px solid #222; border-radius: 12px;
  }
  .shared-post img { display: block; width: 100%; border-radius: 8px; }
  .post-author { color: #aaa; margin-top: 14px; }
  .shared-carousel { position: relative; }
  .shared-carousel-track {
    display: flex; gap: 8px; overflow-x: auto; scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain; -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .shared-carousel-track::-webkit-scrollbar { display: none; }
  .shared-slide { flex: 0 0 100%; min-width: 100%; scroll-snap-align: start; scroll-snap-stop: always; }
  .shared-slide img { margin-bottom: 12px; }
  .shared-carousel-arrow {
    position: absolute; top: 35%; transform: translateY(-50%);
    width: 36px; height: 36px; border: 0; border-radius: 50%;
    background: rgba(0, 0, 0, 0.65); color: #fff; cursor: pointer; z-index: 1;
  }
  .shared-carousel-arrow.prev { left: 10px; }
  .shared-carousel-arrow.next { right: 10px; }
  .shared-carousel-dots { display: flex; justify-content: center; gap: 7px; margin-top: 12px; }
  .shared-carousel-dot { width: 7px; height: 7px; border-radius: 50%; background: #444; }
  .shared-carousel-dot.active { background: #00bfff; }
  .vote-buttons { display: flex; gap: 10px; margin-top: 16px; }
  .vote-btn {
    flex: 1; padding: 14px; border: 0; border-radius: 8px;
    font-size: 16px; font-weight: 700; cursor: pointer;
  }
  .vote-yes { background: #00ff00; color: #000; }
  .vote-no { background: #ff0000; color: #fff; }
  .vote-count { margin-top: 12px; color: #ddd; }
  .vote-status { min-height: 20px; margin-top: 6px; color: #00bfff; }
  .share-post-btn, .comment-submit {
    margin-top: 12px; padding: 9px 14px; border: 1px solid #444;
    border-radius: 8px; background: #222; color: #ddd; cursor: pointer;
  }
  .share-post-btn:hover, .comment-submit:hover { border-color: #00bfff; color: #fff; }
  .comments-section { margin-top: 20px; }
  .comments-list { display: flex; flex-direction: column; gap: 8px; margin: 12px 0; }
  .comment { color: #ddd; font-size: 14px; }
  .comment strong { color: #fff; }
  .comment-form { display: flex; gap: 8px; }
  .comment-input {
    flex: 1; min-width: 0; padding: 10px; border: 1px solid #333;
    border-radius: 8px; background: #222; color: #fff;
  }
</style>

<div class="nav-bar">
  <%= link_to root_path, class: "nav-btn back-to-feed-link" do %>
    <i class="fa-solid fa-arrow-left" aria-hidden="true"></i>
    Back to Feed
  <% end %>
</div>

<main class="shared-post">
  <% initial_slide_index = @posts.index { |post| post.id == @post.id } || 0 %>
  <div class="shared-carousel">
    <div class="shared-carousel-track" id="shared-carousel-track" data-initial-slide="<%= initial_slide_index %>">
      <% @posts.each_with_index do |post, index| %>
        <article class="shared-slide">
          <% if post.image.present? %>
            <%= image_tag post.image.url, alt: "Photo #{index + 1} shared by #{post.user.full_name}" %>
          <% end %>
          <div class="vote-buttons">
            <button type="button" class="vote-btn vote-yes" onclick="voteOnPost(<%= post.id %>, 'yes')">Yes</button>
            <button type="button" class="vote-btn vote-no" onclick="voteOnPost(<%= post.id %>, 'no')">No</button>
          </div>
          <div class="vote-count">
            <strong id="total-votes-<%= post.id %>"><%= post.total_votes_count %></strong> votes:
            <span id="yes-votes-<%= post.id %>"><%= post.yes_votes_count %></span> yes ·
            <span id="no-votes-<%= post.id %>"><%= post.no_votes_count %></span> no
          </div>
          <div id="vote-status-<%= post.id %>" class="vote-status">
            <% if (vote = post.user_vote(current_user)) %>
              You voted <%= vote.vote_type %>
            <% end %>
          </div>
          <section class="comments-section">
            <h2>Comments</h2>
            <div class="comments-list" id="comments-list-<%= post.id %>">
              <% post.comments.each do |comment| %>
                <div class="comment"><strong><%= comment.user.full_name %>:</strong> <%= comment.body %></div>
              <% end %>
            </div>
            <form class="comment-form" onsubmit="return addComment(event, <%= post.id %>)">
              <input type="text" class="comment-input" id="comment-input-<%= post.id %>"
                     placeholder="Add a comment..." maxlength="300" required>
              <button type="submit" class="comment-submit">Post</button>
            </form>
          </section>
        </article>
      <% end %>
    </div>
    <% if @posts.size > 1 %>
      <button type="button" class="shared-carousel-arrow prev" onclick="scrollSharedCarousel(-1)" aria-label="Previous photo">
        <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
      </button>
      <button type="button" class="shared-carousel-arrow next" onclick="scrollSharedCarousel(1)" aria-label="Next photo">
        <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
      </button>
      <div class="shared-carousel-dots" aria-label="Photo navigation">
        <% @posts.each_with_index do |_post, index| %>
          <span class="shared-carousel-dot <%= "active" if index == initial_slide_index %>"></span>
        <% end %>
      </div>
    <% end %>
  </div>
  <div class="post-author">Posted by <%= @post.user.full_name %></div>
  <button type="button" class="share-post-btn" onclick="sharePost()">Share post</button>
</main>

<script>
  async function sharePost() {
    const url = window.location.href;
    const shareData = {
      title: "Inner Circl",
      text: "Can you vote on this post?",
      url
    };

    if (navigator.share) {
      try {
        await navigator.share(shareData);
        return;
      } catch (error) {
        if (error.name === "AbortError") return;
      }
    }

    try {
      await navigator.clipboard.writeText(url);
      alert("Post link copied. Send it to your friend so they can vote.");
    } catch (_error) {
      window.prompt("Copy this link to share the post:", url);
    }
  }

  async function voteOnPost(postId, voteType) {
    try {
      const response = await fetch(`/posts/${postId}/vote`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content
        },
        body: JSON.stringify({ vote_type: voteType })
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || "Vote failed");

      document.getElementById(`total-votes-${postId}`).textContent = data.total_count;
      document.getElementById(`yes-votes-${postId}`).textContent = data.yes_count;
      document.getElementById(`no-votes-${postId}`).textContent = data.no_count;
      document.getElementById(`vote-status-${postId}`).textContent = `You voted ${data.user_vote}`;
    } catch (error) {
      alert(error.message || "Vote failed — try again.");
    }
  }

  async function addComment(event, postId) {
    event.preventDefault();
    const input = document.getElementById(`comment-input-${postId}`);
    const body = input.value.trim();
    if (!body) return false;

    try {
      const response = await fetch(`/posts/${postId}/comments`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content
        },
        body: JSON.stringify({ body })
      });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || "Comment failed");

      const wrapper = document.createElement("div");
      wrapper.className = "comment";
      const author = document.createElement("strong");
      author.textContent = `${data.author}: `;
      wrapper.appendChild(author);
      wrapper.appendChild(document.createTextNode(data.body));
      document.getElementById(`comments-list-${postId}`).appendChild(wrapper);
      input.value = "";
    } catch (error) {
      alert(error.message || "Comment failed — try again.");
    }

    return false;
  }

  function scrollSharedCarousel(direction) {
    const track = document.getElementById("shared-carousel-track");
    const nextIndex = activeSharedSlideIndex(track) + direction;
    if (track.children[nextIndex]) {
      track.scrollTo({ left: sharedSlideLeft(track, nextIndex), behavior: "smooth" });
    }
  }

  function sharedSlideLeft(track, index) {
    return track.children[index].getBoundingClientRect().left -
      track.getBoundingClientRect().left + track.scrollLeft;
  }

  function activeSharedSlideIndex(track) {
    let activeIndex = 0;
    let smallestDistance = Infinity;
    for (let index = 0; index < track.children.length; index++) {
      const distance = Math.abs(sharedSlideLeft(track, index) - track.scrollLeft);
      if (distance < smallestDistance) {
        activeIndex = index;
        smallestDistance = distance;
      }
    }
    return activeIndex;
  }

  const sharedTrack = document.getElementById("shared-carousel-track");
  if (sharedTrack) {
    const initialSlide = Number(sharedTrack.dataset.initialSlide) || 0;
    sharedTrack.scrollLeft = sharedSlideLeft(sharedTrack, initialSlide);

    const dots = sharedTrack.parentElement.querySelectorAll(".shared-carousel-dot");
    let lastIndex = initialSlide;
    sharedTrack.addEventListener("scroll", () => {
      const index = activeSharedSlideIndex(sharedTrack);
      if (index === lastIndex) return;
      lastIndex = index;
      dots.forEach((dot, dotIndex) => dot.classList.toggle("active", dotIndex === index));
    }, { passive: true });
  }
</script>
